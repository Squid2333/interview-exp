# OpenAI-compatible chat completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_FAST=gpt-4.1-mini
AI_MODEL_QUALITY=gpt-4.1
AI_DAILY_REQUEST_LIMIT=120
# Supabase Connect > Direct > Transaction Pooler (port 6543)
# Replace the placeholder and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional override; prod-ca-2021.crt is used by default.
# Use the full PEM certificate; literal \\n sequences are accepted.
DATABASE_SSL_CA=

# Supabase Settings > API / API Keys. Publishable or legacy anon key, not secret/service_role.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only this confirmed Supabase Auth email can access the shared personal question bank.
APP_OWNER_EMAIL=1767257028@qq.com
